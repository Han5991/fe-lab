{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**",
        "dist/**",
        "build/**"
      ]
    },
    // lint·check-types는 의존 패키지의 산출물을 읽지 않으니 `^lint`처럼 기다릴 필요는 없다.
    // 그래도 의존 패키지가 바뀌면 해시는 바뀌어야 하므로 빈 transit 태스크로 해시만 잇는다.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
