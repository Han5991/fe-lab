{
  "name": "fe-lab",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,mts,tsx,js,jsx,json,md,mjs,cjs,yml,yaml}\" --ignore-path .prettierignore --cache",
    "format:check": "prettier --check \"**/*.{ts,mts,tsx,js,jsx,json,md,mjs,cjs,yml,yaml}\" --ignore-path .prettierignore --cache",
    "blog-write": "pnpm --filter @blog/web dev:web",
    "new-post": "pnpm --filter @blog/web new-post",
    "clean": "pnpm clean:dist && pnpm clean:modules",
    "clean:dist": "find . -name node_modules -prune -o -type d '(' -name dist -o -name .next -o -name out -o -name .turbo ')' -prune -exec rm -rf {} +",
    "clean:modules": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0"
  }
}
