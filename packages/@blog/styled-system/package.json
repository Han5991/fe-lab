{
  "name": "@blog/styled-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "panda codegen --cwd ../../../apps/blog/web --config panda.config.ts",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@pandacss/preset-panda": "catalog:"
  },
  "exports": {
    "./css": {
      "types": "./css/index.d.ts",
      "default": "./css/index.js"
    },
    "./patterns": {
      "types": "./patterns/index.d.ts",
      "default": "./patterns/index.js"
    },
    "./tokens": {
      "types": "./tokens/index.d.ts",
      "default": "./tokens/index.js"
    },
    "./types": {
      "types": "./types/index.d.ts"
    }
  }
}
