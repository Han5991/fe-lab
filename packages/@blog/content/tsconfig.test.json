{
  "$schema": "https://json.schemastore.org/tsconfig",
  // 테스트 파일 전용 tsconfig — 앱(apps/blog/web)의 분할과 같은 구조.
  // 프로덕션(tsconfig.json)을 extends하되 include를 테스트 파일로 뒤집는다 —
  // 프로덕션 소스는 import를 통해 함께 검사된다.
  // 프로덕션 전용 엄격 플래그는 @blog/tsconfig/test.json이 끈다(뒤가 이긴다).
  "extends": ["./tsconfig.json", "@blog/tsconfig/test.json"],
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules"]
}
