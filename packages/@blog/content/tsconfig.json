{
  "$schema": "https://json.schemastore.org/tsconfig",
  // 엄격 플래그는 @blog/tsconfig/strict.json이 정한다 — 이 패키지의 소스는 앱 program에도
  // (import를 통해) 들어가므로 앱과 같은 베이스를 쓴다. 실험 앱용 @package/config는
  // extends하지 않는다. allowImportingTsExtensions는 양쪽에 같이 켜져 있다(아래 참고).
  "extends": "@blog/tsconfig/strict.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // 상대 import가 전부 `.ts` 확장자를 달고 있다 — 빌드 스크립트를 node로
    // 직접 실행하기 위해서다(node의 ESM 로더는 확장자를 생략할 수 없다).
    // 앱 tsconfig에도 같이 켜 둬야 한다: 이 소스가 앱 program에 섞이므로
    // 한쪽만 켜면 그쪽에서 TS5097이 난다.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "incremental": true
  },
  // 루트의 `eslint.config.mts`도 프로그램에 든다. 앱은 include가 루트 기준
  // 글롭이라 자동으로 들어오지만 여기는 src 아래만 보므로 명시한다 —
  // 빠뜨리면 tsc가 "에러 0"을 말하는데 그건 검사해서가 아니라 파일을 본 적이
  // 없어서다(ESLint의 projectService도 "not found by the project service"로 운다).
  "include": ["src/**/*.ts", "src/**/*.mts", "eslint.config.mts"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
