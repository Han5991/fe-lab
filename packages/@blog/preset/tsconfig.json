{
  "$schema": "https://json.schemastore.org/tsconfig",
  // 엄격 플래그는 @blog/tsconfig/strict.json이 정한다 — 이 파일은 앱 program에도
  // (panda.config·content.config의 import로) 들어가므로 앱과 같은 베이스를 쓴다.
  // 베이스의 erasableSyntaxOnly가 여기서 특히 필요하다: content.config.mts가 node의
  // type stripping으로 themeColor를 실행한다.
  "extends": "@blog/tsconfig/strict.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts"]
}
