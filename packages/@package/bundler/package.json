  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "magic-string": "^1.4.1"
  }
}
