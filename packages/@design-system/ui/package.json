{
  "name": "@design-system/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset.ts",
    "./blog-preset": "./src/blog-preset.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./preset": {
        "types": "./dist/preset.d.ts",
        "import": "./dist/preset.js"
      },
      "./blog-preset": {
        "types": "./dist/blog-preset.d.ts",
        "import": "./dist/blog-preset.js"
      }
    }
  },
  "scripts": {
    "prepare": "pnpm panda codegen && pnpm build",
    "codegen": "panda codegen",
    "build": "tsup",
    "release": "pnpm panda prepare && pnpm build && pnpm publish",
    "build-fast": "tsup --no-dts",
    "dev": "pnpm build-fast --watch",
    "fmt": "prettier --write ."
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@design-system/ui-lib": "workspace:^",
    "tsup": "8.4.0",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "react": "catalog:react19",
    "react-dom": "catalog:react19"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
