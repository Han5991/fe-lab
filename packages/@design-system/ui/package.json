{
  "name": "@design-system/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset.ts",
    "./blog-preset": "./src/blog-preset.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./preset": {
        "types": "./dist/preset.d.mts",
        "import": "./dist/preset.mjs"
      },
      "./blog-preset": {
        "types": "./dist/blog-preset.d.mts",
        "import": "./dist/blog-preset.mjs"
      }
    }
  },
  "scripts": {
    "prepare": "pnpm panda codegen && pnpm build",
    "codegen": "panda codegen",
    "build": "tsdown",
    "release": "pnpm panda prepare && pnpm build && pnpm publish",
    "build-fast": "tsdown --no-dts",
    "dev": "pnpm build-fast --watch",
    "fmt": "prettier --write ."
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@design-system/ui-lib": "workspace:^",
    "tsdown": "0.22.2",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "react": "catalog:react19",
    "react-dom": "catalog:react19"
  },
  "peerDependencies": {
    "@pandacss/dev": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19"
  }
}
