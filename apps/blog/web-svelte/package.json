{
  "name": "@blog/web-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "blog-content build",
    "dev": "vite dev",
    "prebuild": "blog-content build --strict",
    "build": "vite build && pnpm check-seo && pnpm check-bundle",
    "preview": "vite preview",
    "check-seo": "blog-content check-seo",
    "check-bundle": "blog-content check-bundle",
    "lint": "eslint . --max-warnings=0",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "measure": "blog-content measure-bundle"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "dependencies": {
    "@blog/analytics": "workspace:^",
    "@blog/content": "workspace:^",
    "@blog/diagram": "workspace:^",
    "@blog/site-values": "workspace:^",
    "@supabase/postgrest-js": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@design-system/ui": "workspace:^",
    "hastscript": "^9.0.1",
    "mermaid": "^11.17.2",
    "pretendard": "catalog:",
    "refractor": "^5.0.0",
    "rehype-raw": "catalog:",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "catalog:",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:lint",
    "@eslint/js": "catalog:lint",
    "@pandacss/dev": "catalog:",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/hast": "^3.0.5",
    "@types/node": "catalog:",
    "eslint": "catalog:lint",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "catalog:lint",
    "svelte": "^5.44.2",
    "svelte-check": "^4.4.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:lint",
    "vite": "^8.2.2",
    "vitest": "catalog:"
  }
}
