{
  "name": "@blog/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev:web": "npx tsx scripts/build-content.ts",
    "dev": "pnpm supabase-start && pnpm dev:web",
    "dev:web": "next dev",
    "prebuild": "npx tsx scripts/build-content.ts --strict",
    "build": "pnpm prebuild && next build && pnpm check-seo",
    "start": "next start",
    "lint": "eslint .",
    "lint:posts": "npx tsx scripts/validate-posts.ts",
    "check-seo": "npx tsx scripts/check-seo.ts",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm test:node && pnpm test:vitest",
    "test:node": "node --import tsx --test 'domain/**/*.test.ts' 'lib/**/*.test.ts' 'scripts/**/*.test.ts'",
    "test:vitest": "vitest run",
    "test:coverage": "c8 --reporter=text --reporter=text-summary --exclude='**/*.test.ts' --exclude='**/*.config.*' --exclude='**/database.types.ts' node --import tsx --test 'domain/**/*.test.ts' 'lib/**/*.test.ts' 'scripts/**/*.test.ts'",
    "new-post": "npx tsx scripts/new-post.ts",
    "supabase-stop": "supabase stop --all --no-backup --debug",
    "supabase-start": "pnpm supabase-stop && pnpm supabase start"
  },
  "dependencies": {
    "@design-system/ui": "workspace:^",
    "@design-system/ui-lib": "workspace:^",
    "@giscus/react": "^3.1.0",
    "@next/third-parties": "^16.3.0",
    "@ssgoi/react": "6.6.10",
    "@supabase/postgrest-js": "^2.112.2",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "motion": "^13.1.0",
    "next": "catalog:",
    "nuqs": "^2.9.5",
    "pretendard": "^1.3.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.8",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "satori": "^0.29.0",
    "sharp": "0.35.3",
    "supabase": "^2.113.0",
    "tsx": "^4.23.11",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
