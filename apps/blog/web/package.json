{
  "name": "@blog/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npx tsx scripts/build-content.ts",
    "dev": "pnpm supabase-start && next dev",
    "prebuild": "npx tsx scripts/build-content.ts",
    "build": "pnpm prebuild && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:posts": "npx tsx scripts/validate-posts.ts",
    "check-types": "tsc --noEmit",
    "test": "pnpm test:node && pnpm test:vitest",
    "test:node": "node --import tsx --test 'domain/**/*.test.ts' 'lib/**/*.test.ts' 'scripts/**/*.test.ts' 'generate-*.test.ts' 'sync-posts.test.ts'",
    "test:vitest": "vitest run",
    "test:coverage": "c8 --reporter=text --reporter=text-summary --exclude='**/*.test.ts' --exclude='**/*.config.*' --exclude='**/database.types.ts' node --import tsx --test 'domain/**/*.test.ts' 'lib/**/*.test.ts' 'scripts/**/*.test.ts' 'generate-*.test.ts' 'sync-posts.test.ts'",
    "new-post": "npx tsx scripts/new-post.ts",
    "supabase-stop": "supabase stop --all --no-backup --debug",
    "supabase-start": "pnpm supabase-stop && pnpm supabase start"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@design-system/ui": "workspace:^",
    "@design-system/ui-lib": "workspace:^",
    "@giscus/react": "^3.1.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.2.6",
    "@next/third-parties": "^16.2.6",
    "@ssgoi/react": "6.4.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.100.10",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.15.0",
    "mime-types": "^3.0.2",
    "motion": "^12.29.2",
    "next": "catalog:",
    "nuqs": "^2.8.8",
    "pretendard": "^1.3.9",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.5",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.7.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@pandacss/dev": "catalog:",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdx": "^2.0.13",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.8.0",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "c8": "^11.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^29.1.1",
    "satori": "^0.26.0",
    "supabase": "^2.70.5",
    "tsx": "^4.22.0",
    "typescript": "catalog:typescript5",
    "vitest": "^4.0.0-beta.15"
  }
}
