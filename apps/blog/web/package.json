{
  "name": "@blog/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev:web": "npx tsx node_modules/@blog/content/src/scripts/build-content.ts",
    "dev": "pnpm supabase-start && pnpm dev:web",
    "dev:web": "next dev",
    "prebuild": "npx tsx node_modules/@blog/content/src/scripts/build-content.ts --strict",
    "build": "pnpm prebuild && next build && pnpm check-seo",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:posts": "npx tsx node_modules/@blog/content/src/scripts/validate-posts.ts",
    "check-seo": "npx tsx node_modules/@blog/content/src/scripts/check-seo.ts",
    "check-types": "next typegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p supabase/functions/_typecheck/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "new-post": "npx tsx node_modules/@blog/content/src/scripts/new-post.ts",
    "gen:types": "mkdir -p .cache && supabase gen types --lang typescript --local --schema public > .cache/database.types.ts && mv .cache/database.types.ts lib/platform/database.types.ts && prettier --write lib/platform/database.types.ts",
    "supabase-stop": "supabase stop --all --no-backup --debug",
    "supabase-start": "pnpm supabase-stop && pnpm supabase start"
  },
  "dependencies": {
    "@blog/content": "workspace:^",
    "@design-system/ui": "workspace:^",
    "@design-system/ui-lib": "workspace:^",
    "@giscus/react": "^3.1.0",
    "@next/third-parties": "^16.3.0",
    "@ssgoi/react": "6.6.10",
    "@supabase/postgrest-js": "^2.112.3",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "catalog:",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "motion": "^13.1.0",
    "next": "catalog:",
    "nuqs": "^2.9.5",
    "pretendard": "^1.3.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "react-medium-image-zoom": "^5.4.8",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "rehype-raw": "catalog:",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:lint",
    "@eslint/js": "catalog:lint",
    "@next/eslint-plugin-next": "catalog:lint",
    "@pandacss/dev": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "catalog:lint",
    "eslint-import-resolver-typescript": "catalog:lint",
    "eslint-plugin-boundaries": "catalog:lint",
    "eslint-plugin-jsx-a11y": "catalog:lint",
    "eslint-plugin-react-hooks": "catalog:lint",
    "globals": "catalog:lint",
    "jsdom": "catalog:",
    "supabase": "^2.113.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:lint",
    "vitest": "catalog:"
  }
}
