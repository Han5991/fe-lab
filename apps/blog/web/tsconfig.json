{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    // **키를 지우면 안 된다.** next(dev·build·typegen)가 시작할 때
    // `writeConfigurationDefaults`로 tsconfig를 다시 쓰는데, allowJs는 거기서
    // 'suggested'라 **키가 없을 때만** true를 넣는다. 끄려면 지우지 말고 false로
    // 남겨 둘 것 — 값이 있으면 그대로 둔다.
    // false인 이유: include에 js 글롭이 없어도 .ts에서 import하면 program에
    // 딸려 들어오고, 그 파일은 checkJs 없이 무검사로 지나간다. 막아 두면 그런
    // import가 조용히 통과하는 대신 컴파일 에러가 된다.
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // 앱 소스는 확장자 없이 import한다(Next 번들러가 푼다). 이 플래그는
    // @blog/content 때문에 필요하다 — 그 패키지는 상대 import에 `.ts`를 달아
    // node로 직접 실행되고, 소스째 이 program에 섞이므로 여기서도 허용해야
    // TS5097이 안 난다. 허용일 뿐 강제가 아니라 앱 코드 스타일은 그대로다.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "vitest.config.mts",
    "vitest.setup.ts"
  ]
}
