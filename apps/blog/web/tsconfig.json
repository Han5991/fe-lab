{
  "$schema": "https://json.schemastore.org/tsconfig",
  // 엄격 플래그는 @blog/tsconfig/strict.json이 정한다 — 여기는 Next 앱의 환경만 적는다.
  // extends가 있으면 next(dev·build·typegen)는 이 파일을 다시 쓰지 않는다
  // (`writeConfigurationDefaults`가 extends를 보면 손을 뗀다). Next가 요구하는 값
  // (isolatedModules·jsx·module·moduleResolution …)은 여기와 베이스에 이미 있다.
  "extends": "@blog/tsconfig/strict.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // 앱 소스는 확장자 없이 import한다(Next 번들러가 푼다). 이 플래그는
    // @blog/content 때문에 필요하다 — 그 패키지는 상대 import에 `.ts`를 달아
    // node로 직접 실행되고, 소스째 이 program에 섞이므로 여기서도 허용해야
    // TS5097이 안 난다. 허용일 뿐 강제가 아니라 앱 코드 스타일은 그대로다.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    "e2e",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "vitest.config.mts",
    "vitest.setup.ts"
  ]
}
