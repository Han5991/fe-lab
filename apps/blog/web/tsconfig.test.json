{
  "$schema": "https://json.schemastore.org/tsconfig",
  // 테스트 파일 전용 tsconfig. 프로덕션(tsconfig.json)을 extends하되 include를
  // 테스트 파일로 뒤집는다 — 프로덕션 소스는 import를 통해 함께 검사된다.
  // 프로덕션 전용 엄격 플래그는 @blog/tsconfig/test.json이 끈다(뒤가 이긴다).
  "extends": ["./tsconfig.json", "@blog/tsconfig/test.json"],
  "include": [
    "next-env.d.ts",
    // 타입 없는 패키지의 모듈 선언 — 그 패키지를 지연 로드하는 모듈이 컴포넌트를
    // 거쳐 테스트에 끌려 들어온다(프로덕션 tsconfig는 **/*.ts 글롭으로 이미 포함).
    "text-fragments-polyfill.d.ts",
    // 아래 테스트 글롭은 testFiles.mts의 TEST_PROGRAM_FILES와 같은 파일 집합이다 — JSON이라
    // 그 값을 import하지 못해 src/app/testFiles.test.ts가 실제 파일 목록으로 잠근다.
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "vitest.config.mts",
    "vitest.setup.ts",
    // Playwright 런타임 게이트(e2e/) — 러너는 vitest가 아니지만 테스트 코드라 같은
    // 프로그램·같은 완화 플래그로 검사한다. vitest 글롭(src/**)은 이 폴더를 보지 않는다.
    "e2e/**/*.ts"
  ],
  "exclude": ["node_modules", "supabase/functions"]
}
