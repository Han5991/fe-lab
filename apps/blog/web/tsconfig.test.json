{
  "$schema": "https://json.schemastore.org/tsconfig",
  // 테스트 파일 전용 tsconfig. 프로덕션(tsconfig.json)을 extends하되 include를
  // 테스트 파일로 뒤집는다 — 프로덕션 소스는 import를 통해 함께 검사된다.
  // 프로덕션에만 켜는 엄격 플래그는 여기서 명시적으로 끈다(후속 PR).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // 프로덕션 전용 엄격 플래그 — 테스트 코드(및 테스트가 끌어오는 검사)에는 끈다.
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    // vitest 두 프로젝트의 include 글롭(node: src/{shared,domain,lib}, jsdom: 나머지 src)을 합친 것과
    // 대칭 — .spec 파일이 생겨도 프로덕션 tsconfig(무거운 플래그) 쪽으로 떨어지지
    // 않게 미리 라우팅해 둔다.
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "vitest.config.mts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "supabase/functions"]
}
