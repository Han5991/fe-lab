{
  "$schema": "https://json.schemastore.org/tsconfig",
  // `pnpm check-types`(프로덕션 소스) 전용 tsconfig. tsconfig.json을 그대로
  // extends하되 **include에서 `.next/**`를 뺀다.**
  //
  // 왜 별도 파일인가: tsconfig.json의 include는 우리 것이 아니다. next가
  // dev·build 때마다 writeConfigurationDefaults(node_modules/next/dist/lib/
  // typescript/writeConfigurationDefaults.js)로 `.next/types/**/*.ts`와
  // `.next/dev/types/**/*.ts`를 도로 밀어 넣는다 — 저기서 지우면 다음 `next dev`
  // 한 번에 되살아나 워킹 트리만 더러워진다.
  //
  // 왜 빼는가: `.next/types/validator.ts`는 **생성 시점의 라우트 파일 목록을
  // import한다.** 라우트 이름이 바뀌면(admin/analytics/[slug] → [...slug])
  // 예전 산출물이 남은 로컬에서 tsc가 사라진 모듈을 찾다 죽는다. 소스는
  // 멀쩡한데 산출물이 낡아서 나는 실패라 고칠 코드가 없다.
  //
  // 잃는 것: 생성 타입(PageProps·LayoutProps 전역, 타입드 라우트 augmentation)
  // 검사가 이 명령에서 빠진다. 다만 그 검사는 `next build`가 **매번 새로 생성한
  // 산출물로** 그대로 수행하고(pnpm build → next build), CI·배포는 둘 다 build를
  // 지난다. 즉 검사 지점이 "낡을 수 있는 곳"에서 "항상 신선한 곳"으로 옮겨간다.
  "extends": "./tsconfig.json",
  // exclude는 extends에서 상속된다(include만 덮어쓴다).
  "include": ["next-env.d.ts", "**/*.ts", "**/*.mts", "**/*.tsx"]
}
