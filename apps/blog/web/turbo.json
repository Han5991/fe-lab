{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        ".env*",
        "$TURBO_ROOT$/apps/blog/posts/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "$TURBO_ROOT$/apps/blog/posts/**"
      ]
    }
  }
}
